  O_5p + O4+ -> O_5p + O4+;            0.0; 3.826e-19 * sqrt(8.0 * kb * T_O / pi * (m_O+m_O4)/(m_O*m_O4)); # sigma = pi * (r_O+r_O4)^2, r_O = 152 pm, r_O4 = 197 pm
  O_5p + Ar+ -> O_5p + Ar+;            0.0; 3.632e-19 * sqrt(8.0 * kb * T_O / pi * (m_O+m_Ar)/(m_O*m_Ar)); # sigma = pi * (r_O+r_Ar)^2, r_O = 152 pm, r_Ar = 188 pm
  O2 + O+  -> O2 + O+;                 0.0; 3.826e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O)/(m_O2*m_O));     # sigma = pi * (r_O+r_O2)^2, r_O = 152 pm, r_O2 = 197 pm
  O2 + O2+ -> O2 + O2+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * 2 / m_O2);                  # Lieberman 2005, Chapt. 9, Table 9.3 
  O2 + O3+ -> O2 + O3+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O3) / (m_O2*m_O3));
  O2 + O4+ -> O2 + O4+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O4) / (m_O2*m_O4));
  O2 + Ar+ -> O2 + Ar+;                0.0; 5.200e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_Ar) / (m_O2*m_Ar)); # Lieberman 2005, Chapt. 9, Table 9.3 
  O2_a1Ag + O+  -> O2_a1Ag + O+;       0.0; 3.826e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O)/(m_O2*m_O));     # sigma = pi * (r_O+r_O2)^2, r_O = 152 pm, r_O2 = 197 pm
  O2_a1Ag + O2+ -> O2_a1Ag + O2+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * 2 / m_O2);                  # Lieberman 2005, Chapt. 9, Table 9.3 
  O2_a1Ag + O3+ -> O2_a1Ag + O3+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O3) / (m_O2*m_O3));
  O2_a1Ag + O4+ -> O2_a1Ag + O4+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O4) / (m_O2*m_O4));
  O2_a1Ag + Ar+ -> O2_a1Ag + Ar+;      0.0; 5.200e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_Ar) / (m_O2*m_Ar)); # Lieberman 2005, Chapt. 9, Table 9.3 
