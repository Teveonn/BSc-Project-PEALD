  O3+ + O3+ -> O3+ + O3+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O3 / pi * 2 / m_O3);                  # Thorsteinsson 2010
  O4+ + O4+ -> O4+ + O4+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O4 / pi * 2 / m_O4);                  # Thorsteinsson 2010
  Ar+ + Ar+ -> Ar+ + Ar+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_Ar / pi * 2 / m_Ar);                  # Thorsteinsson 2010
  O+ + O2+ -> O+ + O2+;       0.0; 5.000e-19 * sqrt(8.0 * kb * T_O / pi * (m_O+m_O2) / (m_O*m_O2));    # Thorsteinsson 2010
  O+ + O3+ -> O+ + O3+;       0.0; 5.000e-19 * sqrt(8.0 * kb * T_O / pi * (m_O+m_O3) / (m_O*m_O3));    # Thorsteinsson 2010
  O+ + O4+ -> O+ + O4+;       0.0; 5.000e-19 * sqrt(8.0 * kb * T_O / pi * (m_O+m_O4) / (m_O*m_O4));    # Thorsteinsson 2010
  O+ + Ar+ -> O+ + Ar+;       0.0; 5.000e-19 * sqrt(8.0 * kb * T_Ar / pi * (m_O+m_Ar) / (m_O*m_Ar));   # Thorsteinsson 2010
  O2+ + O3+ -> O2+ + O3+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O3) / (m_O2*m_O3)); # Thorsteinsson 2010
  O2+ + O4+ -> O2+ + O4+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O4) / (m_O2*m_O4)); # Thorsteinsson 2010
  O2+ + Ar+ -> O2+ + Ar+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_Ar) / (m_O2*m_Ar)); # Thorsteinsson 2010
  O3+ + O4+ -> O3+ + O4+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_O3 / pi * (m_O3+m_O4) / (m_O3*m_O4)); # Thorsteinsson 2010
  O3+ + Ar+ -> O3+ + Ar+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_Ar / pi * (m_O3+m_Ar) / (m_O3*m_Ar)); # Thorsteinsson 2010
  O4+ + Ar+ -> O4+ + Ar+;     0.0; 5.000e-19 * sqrt(8.0 * kb * T_Ar / pi * (m_O4+m_Ar) / (m_O4*m_Ar)); # Thorsteinsson 2010
end:default

begin:elastic
