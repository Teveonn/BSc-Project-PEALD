  O2_b1Su + O2+ -> O2_b1Su + O2+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * 2 / m_O2);                  # Lieberman 2005, Chapt. 9, Table 9.3 
  O2_b1Su + O3+ -> O2_b1Su + O3+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O3) / (m_O2*m_O3));
  O2_b1Su + O4+ -> O2_b1Su + O4+;      0.0; 4.900e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_O4) / (m_O2*m_O4));
  O2_b1Su + Ar+ -> O2_b1Su + Ar+;      0.0; 5.200e-19 * sqrt(8.0 * kb * T_O2 / pi * (m_O2+m_Ar) / (m_O2*m_Ar)); # Lieberman 2005, Chapt. 9, Table 9.3 
  O3 + O+  -> O3 + O+;                 0.0; 3.826e-19 * sqrt(8.0 * kb * T_O3 / pi * (m_O3+m_O)  / (m_O3*m_O));  # sigma = pi * (r_O+r_O3)^2, r_O = 152 pm, r_O3 = 197 pm
  O3 + O2+ -> O3 + O2+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O3 / pi * (m_O3+m_O2) / (m_O3*m_O2));
  O3 + O3+ -> O3 + O3+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O3 / pi * 2 / m_O3);
  O3 + O4+ -> O3 + O4+;                0.0; 4.900e-19 * sqrt(8.0 * kb * T_O3 / pi * (m_O3+m_O4) / (m_O3*m_O4));
  O3 + Ar+ -> O3 + Ar+;                0.0; 5.200e-19 * sqrt(8.0 * kb * T_O3 / pi * (m_O3+m_Ar) / (m_O3*m_Ar)); 
