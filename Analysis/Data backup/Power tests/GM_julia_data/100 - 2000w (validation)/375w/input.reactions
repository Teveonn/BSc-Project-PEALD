  e + O2 -> e + O2;              0.0; 4.15e-14 * T_e_eV^ 0.599 * exp(-0.016/T_e_eV); # 24
  e + O2_a1Ag -> e + O2_a1Ag;    0.0; 4.15e-15 * T_e_eV^ 0.599 * exp(-0.016/T_e_eV); # 42
