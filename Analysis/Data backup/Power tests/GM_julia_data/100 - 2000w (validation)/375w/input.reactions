  # Hurlbatt (20017)
  e + Ar -> e + Ar;              0.0; 2.336e-14 * T_e_eV^1.609 * exp(0.0618 * (log(T_e_eV))^2 - 0.1171 * (log(T_e_eV))^3 );  
end:elastic

